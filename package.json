{
  "name": "dsh-plan-spend",
  "version": "0.1.0",
  "private": true,
  "description": "Usage Meter: an openable popup showing the configured providers' plan spend — DeepSeek official balance and OpenCode Go 5h/weekly/monthly quota — as an out-of-tree DeepSeek Harness plugin bundle",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "files": [
    "index.js",
    "client.js",
    "client.body.js",
    "cordis.patch.yml",
    "scripts/build-client.mjs"
  ],
  "license": "MIT"
}
